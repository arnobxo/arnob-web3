# EmailJS (https://dashboard.emailjs.com) — used by the contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_TEMPLATE_KEY=your_emailjs_template_id

# Sanity CMS (https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional — defaults to 2023-11-03 if unset
# NEXT_PUBLIC_SANITY_API_VERSION=2023-11-03
